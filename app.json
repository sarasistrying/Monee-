{
  "expo": {
    "name": "Monee",
    "slug": "Monee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sarasistrying.monee",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3260",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.sarasistrying.monee"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Monee",
      "shortName": "Monee",
      "themeColor": "#1E3260",
      "backgroundColor": "#1E3260",
      "description": "Pocket money, sorted. Scan receipts, track spending and save for your goals."
    },
    "plugins": [
      "expo-sharing",
      "expo-font",
      "expo-status-bar",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "74846b1d-3b1c-41d1-88fd-b6618d53ca53"
      }
    }
  }
}
